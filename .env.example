# =========================================================================
# REMIDOS EM CRISTO | MASTER BROADCAST - ENVIRONMENT CONFIGURATION
# =========================================================================

# 1. Supabase Cloud Database (PostgreSQL / REST)
# Obtenha no painel do Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key

# 2. NVIDIA NeMoTron API (Opcional - para IA Igreja)
# Obtenha em https://build.nvidia.com
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Porta do Servidor Web (Padrão: 8765)
PORT=8765
